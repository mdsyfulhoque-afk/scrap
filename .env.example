# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=datafetcheradmin
MINIO_SECRET_KEY=ChangeMe
MINIO_BUCKET=raw

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=data_catalog
POSTGRES_USER=datafetcher
POSTGRES_PASSWORD=ChangeMe

# Fetcher
FETCH_CONNECT_TIMEOUT_SECONDS=5
FETCH_READ_TIMEOUT_SECONDS=25
FETCH_MAX_SIZE_BYTES=10485760
FETCH_MAX_RETRIES=2
FETCH_BACKOFF_SECONDS=1
FETCH_MAX_REDIRECTS=5
FETCH_ALLOWED_DOMAINS=localhost,127.0.0.1
